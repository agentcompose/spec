{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcompose.dev/schemas/common.json",
  "title": "AgentCompose Common Definitions",
  "description": "Shared definitions referenced by other AgentCompose schemas.",
  "$defs": {
    "TaskState": {
      "type": "string",
      "enum": ["submitted", "working", "input-required", "completed", "failed", "canceled"],
      "description": "Lifecycle state of a Task."
    },
    "Part": {
      "description": "A single piece of content exchanged with an agent.",
      "oneOf": [
        { "$ref": "#/$defs/TextPart" },
        { "$ref": "#/$defs/JsonPart" },
        { "$ref": "#/$defs/FilePart" }
      ]
    },
    "TextPart": {
      "type": "object",
      "required": ["kind", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "text" },
        "text": { "type": "string" },
        "mediaType": { "type": "string", "default": "text/plain" }
      }
    },
    "JsonPart": {
      "type": "object",
      "required": ["kind", "json"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "json" },
        "json": {},
        "mediaType": { "type": "string", "default": "application/json" }
      }
    },
    "FilePart": {
      "type": "object",
      "required": ["kind", "mediaType"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "file" },
        "name": { "type": "string" },
        "mediaType": { "type": "string" },
        "uri": { "type": "string", "format": "uri", "description": "Location of the file content." },
        "bytes": { "type": "string", "contentEncoding": "base64", "description": "Inline base64-encoded content." }
      },
      "anyOf": [
        { "required": ["uri"] },
        { "required": ["bytes"] }
      ]
    },
    "AuthScheme": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["none", "bearer", "apiKey", "oauth2"] },
        "description": { "type": "string" },
        "name": {
          "type": "string",
          "description": "For apiKey: the HTTP header carrying the key. Default: 'X-API-Key'."
        },
        "in": {
          "type": "string",
          "enum": ["header"],
          "default": "header",
          "description": "For apiKey: where the credential is sent. Only 'header' is supported in 0.x."
        },
        "metadataUrl": {
          "type": "string",
          "format": "uri",
          "description": "For oauth2: the OAuth 2.0 Authorization Server Metadata URL (RFC 8414)."
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "For oauth2: scopes the caller must request."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "oauth2" } }, "required": ["type"] },
          "then": { "required": ["metadataUrl"] }
        }
      ]
    },
    "Extensions": {
      "type": "object",
      "description": "Free-form, reverse-DNS namespaced extension data. Consumers MUST ignore unknown keys.",
      "additionalProperties": true
    }
  }
}
