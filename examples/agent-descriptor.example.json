{
  "agentcomposeVersion": "0.1.0",
  "id": "dev.agentcompose.agents.research",
  "name": "Research Agent",
  "version": "1.0.0",
  "description": "Researches a topic and returns a structured summary with sources.",
  "provider": { "name": "AgentCompose", "url": "https://agentcompose.dev" },
  "capabilities": [
    {
      "id": "research",
      "description": "Given a goal, gather and synthesize information into a summary with citations.",
      "inputModes": ["text/plain"],
      "outputModes": ["text/markdown", "application/json"],
      "tags": ["research", "web", "summarization"]
    }
  ],
  "endpoint": "https://research.example.com/agentcompose",
  "auth": { "type": "bearer", "description": "Bearer token issued by the provider." },
  "taskRetention": 86400,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "depth": {
        "type": "string",
        "enum": ["shallow", "deep"],
        "default": "shallow",
        "description": "How thoroughly to research."
      },
      "systemPrompt": { "$ref": "https://agentcompose.dev/schemas/config.json#/$defs/SystemPrompt" },
      "provider": { "$ref": "https://agentcompose.dev/schemas/config.json#/$defs/Provider" },
      "limits": { "$ref": "https://agentcompose.dev/schemas/config.json#/$defs/Limits" }
    }
  },
  "documentationUrl": "https://research.example.com/docs"
}
